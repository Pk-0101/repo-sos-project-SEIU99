    @IsTest
    static void testJobToContactMapping() {

        Account employer =
            SEIU99SyncTestDataFactory.createAccount('Mapping Employer');

        CVSR__Worksite__c ws =
            SEIU99SyncTestDataFactory.createWorksite(
                    'Mapping Worksite',
                    employer.Id
                );

        Contact con = new Contact();

        CVSR__Job__c job =
            new CVSR__Job__c(
                OwnerId = UserInfo.getUserId(),
                CVSR__Employer__c = employer.Id,
                CVSR__Worksite__c = ws.Id,
                Bargaining_Unit__c = 'BU-TEST',
                CVSR__JOB_RE_HIRE_DT__c =
                    Date.today().addYears(-1),
                CVSR__JOB_SENIORITY_DT__c =
                    Date.today().addYears(-5),
                Last_Paid_Date__c = Date.today(),
                COPE_Amount__c = 25,
                Effective_Date_COPE__c =
                    Date.today(),
                Employee_ID__c = 'EMP001',
                HourlyRate__c = 30,
                CVSR__JOB_BASE_SALARY__c = 50000,
                Daily_Hours__c = 8,
                Job_Type__c = 'Full Time',
                Status_Reason_Code__c = 'ACTIVE',
                Worker_Type__c = 'Employee',
                Worker_Sub_Type__c = 'Regular',
                Hire_Date__c =
                    Date.today().addYears(-5),
                Leave_Notification_Date__c =
                    Date.today()
            );

        SEIU99JobContactSyncService.mapJobToContact(con, job);

        System.assertEquals(
            employer.Id,
            con.AccountId
        );

        System.assertEquals(
            ws.Id,
            con.Worksite__c
        );

        System.assertEquals(
            'BU-TEST',
            con.Bargaining_Unit__c
        );

        System.assertEquals(
            Date.today(),
            con.Paid_Through_Date_Start__c
        );

        System.assertEquals(
            'EMP001',
            con.Employee_ID__c
        );

        System.assertEquals(
            30,
            con.Hourly_Rate__c
        );

        System.assertEquals(
            50000,
            con.Wage_Rate__c
        );

        System.assertEquals(
            8,
            con.Daily_Hours__c
        );

        System.assertEquals(
            'Full Time',
            con.Job_Type__c
        );

        System.assertEquals(
            'ACTIVE',
            con.Status_Reason_Code__c
        );

        System.assertEquals(
            'Employee',
            con.Worker_Type__c
        );

        System.assertEquals(
            'Regular',
            con.Worksr_Subtype__c
        );

        System.assertEquals(
            UserInfo.getUserId(),
            con.OwnerId
        );
    }
