@IsTest
private class SEIU99JobContactSyncServiceTest {

    @IsTest
    static void testSingleInactiveJobPrimary() {

        Contact con =
            SEIU99SyncTestDataFactory.createLocalMember();

        CVSR__Job__c job =
            new CVSR__Job__c(
                CVSR__Worker__c = con.Id,
                Active__c = false,
                Last_Paid_Date__c = Date.today()
            );

        insert job;

        List<CVSR__Job__c> jobs = [
            SELECT
                Id,
                CVSR__Worker__c,
                Active__c,
                Last_Paid_Date__c,
                LastModifiedDate
            FROM CVSR__Job__c
            WHERE CVSR__Worker__c = :con.Id
        ];

        Map<Id, CVSR__Job__c> result =
            SEIU99JobContactSyncService.selectPrimaryJobs(jobs);

        System.assertEquals(
            job.Id,
            result.get(con.Id).Id
        );
    }


    @IsTest
    static void testActivePreferredOverInactive() {

        Contact con =
            SEIU99SyncTestDataFactory.createLocalMember();

        CVSR__Job__c inactiveJob =
            new CVSR__Job__c(
                CVSR__Worker__c = con.Id,
                Active__c = false,
                Last_Paid_Date__c = Date.today()
            );

        CVSR__Job__c activeJob =
            new CVSR__Job__c(
                CVSR__Worker__c = con.Id,
                Active__c = true,
                Last_Paid_Date__c =
                    Date.today().addDays(-20)
            );

        insert new List<CVSR__Job__c>{
            inactiveJob,
            activeJob
        };

        List<CVSR__Job__c> jobs = [
            SELECT
                Id,
                CVSR__Worker__c,
                Active__c,
                Last_Paid_Date__c,
                LastModifiedDate
            FROM CVSR__Job__c
            WHERE CVSR__Worker__c = :con.Id
            ORDER BY
                Active__c DESC,
                Last_Paid_Date__c DESC NULLS LAST,
                LastModifiedDate DESC,
                Id DESC
        ];

        Map<Id, CVSR__Job__c> result =
            SEIU99JobContactSyncService.selectPrimaryJobs(jobs);

        System.assertEquals(
            activeJob.Id,
            result.get(con.Id).Id,
            'Active Job must win over Inactive Job.'
        );
    }


